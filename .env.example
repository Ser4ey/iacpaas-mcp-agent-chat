# Существующие данные IACPaaS. JWT автоматически обновляется при входе.
IACPAAS_USERNAME=
IACPAAS_PASSWORD=
# Вместо логина/пароля можно использовать выданный администратором ключ.
# IACPAAS_API_KEY=
# Временный JWT поддерживается, но истекает; логин/пароль удобнее.
# IACPAAS_ACCESS_TOKEN=

# Модель: любой сервер с протоколом OpenAI Chat Completions. По умолчанию — RouterAI, заполните ключ.
# Старые OPENROUTER_* также поддерживаются.
ROUTERAI_API_KEY=
ROUTERAI_MODEL=deepseek/deepseek-v4.1-flash
ROUTERAI_BASE_URL=https://routerai.ru/api/v1
# Имя ROUTERAI_BASEURL из существующего .env также поддерживается.

# Локальная модель (README, «Локальная модель»): ключ не нужен, стоимость — «бесплатно».
# LM Studio:
# ROUTERAI_BASE_URL=http://127.0.0.1:1234/v1
# ROUTERAI_MODEL=qwen3-4b-instruct-2507
# ROUTERAI_API_KEY=
# Ollama (сервер запускать с OLLAMA_CONTEXT_LENGTH=32768):
# ROUTERAI_BASE_URL=http://127.0.0.1:11434/v1
# ROUTERAI_MODEL=qwen3:4b
# MODEL_CONTEXT_TOKENS=32768
# Локальным считается адрес на этом компьютере или в локальной сети; иначе задайте явно:
# MODEL_LOCAL=true
# Сколько секунд ждать ответа модели на одно обращение; локальной модели нужно 300–600.
# MODEL_TIMEOUT_SECONDS=120

APP_HOST=127.0.0.1
APP_PORT=8000
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_URL=http://127.0.0.1:8001/mcp
# При запуске: пустой индекс загружается целиком, готовый сверяется с IACPaaS по датам изменения
# ресурсов и обновляется только в изменившихся ресурсах (в фоне). false — индекс не трогать.
AUTO_SYNC_ON_START=true

# Окно контекста и цены модели приложение берёт из каталога провайдера (GET /models);
# у LM Studio — окно загруженной модели; если никто не сообщил — окно 32 768, цены неизвестны.
# Задавайте их здесь, только если нужно переопределить:
# MODEL_CONTEXT_TOKENS=1048576
# MAX_CONTEXT_TOKENS=200000        # мягкий лимит истории, чтобы ограничить расходы
# PRICE_INPUT_PER_MILLION=5.36
# PRICE_OUTPUT_PER_MILLION=9.57
# MAX_OUTPUT_TOKENS=4096
# MAX_TOOL_STEPS=8                 # шагов «модель → инструменты» на один вопрос
# MAX_TOOL_CALLS=16

# История для модели: последние HISTORY_FULL_TURNS ходов уходят полностью,
# у более старых результаты инструментов обрезаются до HISTORY_TOOL_CHARS символов.
# HISTORY_FULL_TURNS=2
# HISTORY_TOOL_CHARS=1500

# Живое чтение вершин и подграфов с IACPaaS (поиск всегда по локальному индексу).
# LIVE_READS=true

# Модель проверяющего (кнопка «Проверить»); по умолчанию ROUTERAI_MODEL.
# VERIFIER_MODEL=

# Запись в «Мой фонд»: создание папок и ресурсов, переименование вершин, удаление.
# Каждая запись требует подтверждения пользователя в интерфейсе (по умолчанию 120 с).
# Базовые ресурсы из config/resources.json и папка «Загрузки» защищены всегда.
# WRITE_ENABLED=true               # false — только чтение, без записи и чтения по пути
# PROTECTED_PATHS=                 # ещё защищённые пути через «;», например: Архив;Личное / Отчёты
# WRITE_CONFIRM_TIMEOUT_SECONDS=120

# Температура модели агента и проверяющего. 0 — ответы на одинаковые вопросы расходятся меньше.
# MODEL_TEMPERATURE=0
